<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Psiphon" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/og_red</item>
        <item name="colorPrimaryDark">@color/og_red_dark</item>
        <item name="colorAccent">@color/og_gold</item>
        <item name="android:windowBackground">@color/og_background</item>
        <item name="android:colorBackground">@color/og_background</item>
        <item name="android:textColorPrimary">@color/og_text_primary</item>
        <item name="android:textColorSecondary">@color/og_text_secondary</item>
        <item name="android:fontFamily">@font/vazirmatn_black</item>
        <item name="fontFamily">@font/vazirmatn_black</item>
        <item name="alertDialogTheme">@style/Theme.OpenGuard.Dialog</item>
        <item name="buttonStyle">@style/Widget.OpenGuard.Button</item>
        <item name="android:buttonStyle">@style/Widget.OpenGuard.Button</item>
    </style>
    <style name="Theme.Psiphon.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/og_red</item>
        <item name="colorPrimaryDark">@color/og_red_dark</item>
        <item name="colorAccent">@color/og_gold</item>
        <item name="android:windowBackground">@color/og_background</item>
        <item name="android:colorBackground">@color/og_background</item>
        <item name="android:textColorPrimary">@color/og_text_primary</item>
        <item name="android:textColorSecondary">@color/og_text_secondary</item>
        <item name="android:fontFamily">@font/vazirmatn_black</item>
        <item name="fontFamily">@font/vazirmatn_black</item>
        <item name="alertDialogTheme">@style/Theme.OpenGuard.Dialog</item>
        <item name="buttonStyle">@style/Widget.OpenGuard.Button</item>
        <item name="android:buttonStyle">@style/Widget.OpenGuard.Button</item>
    </style>
    <style name="Theme.DialogAlert" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/bg_dialog_round</item>
        <item name="colorAccent">@color/og_gold</item>
        <item name="android:fontFamily">@font/vazirmatn_black</item>
        <item name="fontFamily">@font/vazirmatn_black</item>
    </style>
    <style name="Theme.OpenGuard.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_round</item>
        <item name="colorAccent">@color/og_gold</item>
        <item name="android:fontFamily">@font/vazirmatn_black</item>
        <item name="fontFamily">@font/vazirmatn_black</item>
    </style>
    <style name="Widget.OpenGuard.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_pill</item>
        <item name="android:textColor">@color/og_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/vazirmatn_black</item>
    </style>
    <style name="Widget.OpenGuard.RoundButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/bg_button_round</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
